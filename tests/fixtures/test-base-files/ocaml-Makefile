
include pertest-ocaml-Makefile

PACKAGES := $(PACKAGES),antlr,cmdliner,yojson,pa_ppx.located_yojson,pa_ppx.runtime


ALLSRC=$(ML)
ALLPACKAGES=$(PACKAGES)

TESTS=test.exe
TESTSOPT=$(TESTS:.exe=.opt)

LOCARG=-n

ifdef MAXDEPTH
  MAXDEPTHARG := -m $(MAXDEPTH)
endif

EEARGS=$(LOCARG) $(MAXDEPTHARG)

ocaml-test:: ocaml-compile
	env TOP=$(TOP) $(RUNNER) run --ocaml $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --ee-args "$(EEARGS)" --ocaml $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) run --ocaml --lexer-only $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --lexer-only --ee-args "$(EEARGS)" --ocaml $(SHOWARGS)

ocaml-test-named-output:: ocaml-compile
	env TOP=$(TOP) $(RUNNER) run --ocaml --named-types $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --ee-args "$(EEARGS)" --ocaml --named-types $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) run --ocaml --lexer-only --named-types $(SHOWARGS)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --lexer-only --ee-args "$(EEARGS)" --ocaml --named-types $(SHOWARGS)

named-ocaml-test:: ocaml-compile
	env TOP=$(TOP) $(RUNNER) run --ocaml $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --ee-args "$(EEARGS)" --ocaml $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) run --ocaml --lexer-only $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --lexer-only --ee-args "$(EEARGS)" --ocaml $(SHOWARGS) $(NAME)

named-ocaml-test-named-output:: ocaml-compile
	env TOP=$(TOP) $(RUNNER) run --ocaml --named-types $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --ee-args "$(EEARGS)" --ocaml --named-types $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) run --ocaml --named-types --lexer-only $(SHOWARGS) $(NAME)
	env TOP=$(TOP) $(RUNNER) json-entry-exit --lexer-only --ee-args "$(EEARGS)" --ocaml --named-types $(SHOWARGS) $(NAME)

ocaml-compile:: $(TESTS) $(TESTSOPT)

test.exe: $(ML:.ml=.cmo)
	$(LAUNCH) $(OCAMLFIND) ocamlc -linkall -linkpkg $(DEBUG) $(OCAMLCFLAGS) -package $(PACKAGES) -linkpkg -linkall -o $@ $^

test.opt: $(ML:.ml=.cmx)
	$(LAUNCH) $(OCAMLFIND) ocamlopt -linkall -linkpkg $(DEBUG) $(OCAMLCFLAGS) -package $(PACKAGES) -linkpkg -linkall -o $@ $^

clean::
	rm -f *.cm* *.opt *.exe ocaml-errors* ocaml-output* ocaml-json* *.RAW
