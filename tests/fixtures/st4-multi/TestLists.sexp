(
("testCatNullValues"
((classname hello)
 (runs
  (
   ((input "<[no,go]; null=\"foo\", separator=\", \">")
    (output "foo, foo")
    (attributes ((phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )

   )
  )
 (errors {bar|context [anonymous] 1:2 attribute no isn't defined
context [anonymous] 1:5 attribute go isn't defined
|bar})
 ))
("testCatWithNullTemplateApplicationAsElement"
((classname hello)
 (runs
  (
   ((input "<[names, [\"foo\",\"bar\"]:{x | <x>!},phones]; separator=\", \">")
    (output "Ter, Tom, foo!, bar!, 1, 2")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   )
  )
 ))
("testCatWithNullTemplateApplicationAsElement2"
((classname hello)
 (runs
  (
   ((input {|<[names, {<["foo","bar"]:{x | <x>!}; separator=", ">},phones]; separator=", ">|})
    (output "Ter, Tom, foo!, bar!, 1, 2")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   )
  )
 ))
("testJustCat"
((classname hello)
 (runs
  (((input "<[names,phones]>")
    (output "TerTom12")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   ((input "<[\"Ter\",,\"Jesse\"]:{n | <i>:<n>}; separator=\", \", null={foo}>")
    (output "1:Ter, foo, 2:Jesse")
    )
   ((input "<[,\"Ter\",\"Jesse\"]:{n | <i>:<n>}; separator=\", \", null={foo}>")
    (output "foo, 1:Ter, 2:Jesse")
    )
   ((input "<length([names,phones])>")
    (output "4")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   ((input "<[names,phones]; separator=\", \">")
    (output "Ter, Tom, 1, 2")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   ((input "<[names,phones]:{a|<a>.}>")
    (output "Ter.Tom.1.2.")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   ((input "<[names,phones,salaries]; separator=\", \">")
    (output "Ter, Tom, 1, 2, big, huge")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 (salaries (MV ((STRING "big") (STRING "huge"))))
    		 ))
    )
   ((input "<[ {<names:{n|<n>!}; separator=\", \">} ,phones]; separator=\", \">")
    (output "Ter!, Tom!, 1, 2")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   ((input "<[{<if(names)>doh<endif>},phones]; separator=\", \">")
    (output "doh, 1, 2")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   )
  )
 ))
("testListAsTemplateArgument"
((classname hello)
 (groupfile (("t.stg" {|
test(names,phones) ::= "<foo([names,phones])>"
foo(items) ::= "<items:{a | *<a>*}>"
|})))
 (runs
  (
   ((input "<test(names,phones)>")
    (output "*Ter**Tom**1**2*")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   )
  )
 ))
("testListWithTwoEmptyListsCollapsesToEmptyList"
((classname hello)
 (runs
  (
   ((input "<[[],[]]:{x | <x>!}; separator=\", \">")
    (output "")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 ))
    )
   )
  )
 ))
)
