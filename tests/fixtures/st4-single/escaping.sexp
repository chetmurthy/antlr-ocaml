((classname hello)
   (runs
    (
     ((input {|\<|})
      (output {bar|<|bar})
      )
     ((input {|\}|})
      (output {bar|}|bar})
      )
     ((input {|\>|})
      (output {bar|\>|bar})
      )
     ((input {|\\|})
      (output {bar|\|bar})
      )
     ((input {|txt = txt.replace("\r","\\r")|})
      (output {bar|txt = txt.replace("\r","\r")|bar})
      )
     ((input {|<["a","b"]; separator="\n">|})
      (output "a\nb")
      )
     ((input {|<["a","b"]; separator="\r">|})
      (output "ab")
      )
     ((input {|a<"\n">b|})
      (output "a\nb")
      )
     ((input {|a<"\r">b|})
      (output "ab")
      )
     ((input {|<"\\">|})
      (output {bar|\|bar})
      )
     ((input {|<"\\n">|})
      (output {bar|\n|bar})
      )
     ((input {|{ <" '\\n' in string"> }|})
      (output {bar|{  '\n' in string }|bar})
      )
     )
   )
 )