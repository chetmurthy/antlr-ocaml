((classname hello)
   (runs
    (
     ((input {|\<|})
      (output {bar|<|bar})
      )
     ((input {|\}|})
      (output {bar|}|bar})
      )
     ((input {|\>|})
      (output {bar|\>|bar})
      )
     ((input {|\\|})
      (output {bar|\|bar})
      )
     ((input {|txt = txt.replace("\r","\\r")|})
      (output {bar|txt = txt.replace("\r","\r")|bar})
      )
     )
   )
 )