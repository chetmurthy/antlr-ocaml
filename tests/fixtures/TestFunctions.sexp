(
("testCatListAndEmptyAttributes"
((classname hello)
 (runs
  (((input "<[x,mine,y,yours,z]; separator=\", \">")
    (output "1, 2, 3, a")
    (attributes ((mine (MV ((STRING "1") (STRING "2") (STRING "3"))))
    		 (yours (MV ((STRING "a"))))
    		 ))
    )
   ((input "<[x,mine,y,yours,z]; separator=\", \">")
    (output "1, 2, 3, a")
    (attributes ((mine (SV (LIST ((STRING "1") (STRING "2") (STRING "3")))))
    		 (yours (MV ((STRING "a"))))
    		 ))
    )
   )
  )
 (errors {bar|context [anonymous] 1:2 attribute x isn't defined
context [anonymous] 1:9 attribute y isn't defined
context [anonymous] 1:17 attribute z isn't defined
context [anonymous] 1:2 attribute x isn't defined
context [anonymous] 1:9 attribute y isn't defined
context [anonymous] 1:17 attribute z isn't defined
|bar})
 ))
("testCatListAndSingleAttribute"
((classname hello)
 (runs
  (((input "<[mine,yours]; separator=\", \">")
    (output "1, 2, 3, a")
    (attributes ((mine (MV ((STRING "1") (STRING "2") (STRING "3"))))
    		 (yours (MV ((STRING "a"))))
    		 ))
    )
   ((input "<[mine,yours]; separator=\", \">")
    (output "1, 2, 3, a")
    (attributes ((mine (SV (LIST ((STRING "1") (STRING "2") (STRING "3")))))
    		 (yours (MV ((STRING "a"))))
    		 ))
    )

   )
  )
 ))
("testCombinedOp"
((classname hello)
 (runs
  (((input "<[first(mine),rest(yours)]; separator=\", \">")
    (output "1, b")
    (attributes ((mine (MV ((STRING "1") (STRING "2") (STRING "3"))))
    		 (yours (MV ((STRING "a") (STRING "b"))))
    		 ))
    )
   ((input "<[first(mine),rest(yours)]; separator=\", \">")
    (output "1, b")
    (attributes ((mine (SV (LIST ((STRING "1") (STRING "2") (STRING "3")))))
    		 (yours (MV ((STRING "a") (STRING "b"))))
    		 ))
    )
   )
  )
 ))
("testFirst"
((classname hello)
 (runs
  (((input "<first(names)>")
    (output "Ter")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom)))))))
    )
   ((input "<length(names)>")
    (output "2")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom)))))))
    )
   ((input "<length(names)>")
    (output "4")
    (attributes ((names (SV (LIST ((STRING Ter) NULL (STRING Tom) NULL))))))
    )
   ((input "<first(names)>")
    (output "Ter")
    (attributes ((names (MV ((STRING Ter) (STRING Tom) (STRING Sriram))))))
    )
   ((input "<trunc(names); separator=\", \">")
    (output "Ter, Tom")
    (attributes ((names (MV ((STRING Ter) (STRING Tom) (STRING Sriram))))))
    )
   ((input "<trunc(names); separator=\", \">")
    (output "Ter, Tom")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom) (STRING Sriram)))))))
    )

   ((input "<rest(names); separator=\", \">")
    (output "Tom, Sriram")
    (attributes ((names (MV ((STRING Ter) (STRING Tom) (STRING Sriram))))))
    )
   ((input "<rest(names); separator=\", \">")
    (output "Tom, Sriram")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom) (STRING Sriram)))))))
    )
   ((input "<rest(names); separator=\", \">")
    (output "")
    (attributes ((names (SV (LIST ())))))
    )
   )
  )
 ))
("testFirstWithCatAttribute"
((classname hello)
 (runs
  (((input "<first([names,phones])>")
    (output "Ter")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 (phones (MV ((STRING "1") (STRING "2"))))
    		 ))
    )
   )
  )
 ))
("testFirstWithListOfMaps"
((classname hello)
 (runs
  (((input "<first(maps).Ter>")
    (output "x5707")
    (attributes ((maps (MV ((DICT ((Ter (STRING x5707)))) (DICT ((Tom (STRING x5332)))))))
    		 ))
    )
   ((input "<first(maps):{ m | <m>!}>")
    (output "Ter!")
    (attributes ((maps (MV ((DICT ((Ter (STRING x5707)))) (DICT ((Tom (STRING x5332)))))))
    		 ))
    )
   )
  )
 ))
("testFirstWithOneAttributeOp"
((classname hello)
 (runs
  (((input "<first(names)>")
    (output "Ter")
    (attributes ((names (MV ((STRING "Ter"))))
    		 ))
    )
   ((input "<last(names)>")
    (output "Ter")
    (attributes ((names (MV ((STRING "Ter"))))
    		 ))
    )
   ((input "<last(names)>")
    (output "Ter")
    (attributes ((names (SV (LIST ((STRING Ter)))))
    		 ))
    )
   ((input "<last(names)>")
    (output "0")
    (attributes ((names (SV (LIST ((INT 0)))))
    		 ))
    )
   ((input "<rest(names)>")
    (output "")
    (attributes ((names (MV ((STRING "Ter"))))
    		 ))
    )
   ((input "<rest(names)>")
    (output "")
    (attributes ((names (SV (LIST ((STRING Ter)))))
    		 ))
    )

   )
  )
 ))
("testLastOp"
((classname hello)
 (runs
  (((input "<last(names)>")
    (output "Sriram")
    (attributes ((names (MV ((STRING Ter) (STRING Tom) (STRING Sriram))))))
    )
   ((input "<last(names)>")
    (output "Sriram")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom) (STRING Sriram)))))))
    )
   ((input "<last(names)>")
    (output "2")
    (attributes ((names (MV ((INT 0) (INT 1) (INT 2))))))
    )
   )
  )
 ))
("testNestedOp"
((classname hello)
 (runs
  (((input "<first(rest(names))>")
    (output "Tom")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom") (STRING "Sriram"))))
    		 ))
    )
   ((input "<first(rest(names))>")
    (output "Tom")
    (attributes ((names (SV (LIST ((STRING "Ter") (STRING "Tom") (STRING "Sriram")))))
    		 ))
    )
   )
  )
 ))
("testRepeatedRestOp"
((classname hello)
 (runs
  (((input "<rest(names)>, <rest(names)>")
    (output "Tom, Tom")
    (attributes ((names (MV ((STRING "Ter") (STRING "Tom"))))
    		 ))
    )
   ((input "<rest(names)>, <rest(names)>")
    (output "Tom, Tom")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom)))))
    		 ))
    )
   )
  )
 ))
("testReUseOfCat"
((classname hello)
 (groupfile (("g.stg" {|
a(mine,yours) ::= "<b([mine,yours])>"
b(x) ::= "<x>, <x>"
|})))
 (runs
  (((input "<a(mine,yours)>")
    (output "TerTomFoo, TerTomFoo")
    (attributes ((mine (SV (LIST ((STRING "Ter") (STRING "Tom")))))
    		 (yours (SV (LIST ((STRING "Foo")))))
    		 ))
    )
   )
  )
 ))
("testReUseOfRestResult"
((classname hello)
 (groupfile (("t.stg" {|
a(names) ::= "<b(rest(names))>"
b(x) ::= "<x>, <x>"
|})))
 (runs
  (((input "<a(names)>")
    (output "Tom, Tom")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom)))))))
    )
   ((input "<a(names)>")
    (output "1, 1")
    (attributes ((names (SV (LIST ((INT 0) (INT 1)))))))
    )
   )
  )
 ))
("testStripOp"
((classname hello)
 (runs
  (((input "<strip(names); null=\"n/a\">")
    (output "TomSriram")
    (attributes ((names (MV (NULL (STRING Tom) NULL NULL (STRING Sriram) NULL)))))
    )
   ((input "<strip(names); null=\"n/a\">")
    (output "TomSriram")
    (attributes ((names (SV (LIST (NULL (STRING Tom) NULL NULL (STRING Sriram) NULL))))))
    )
   ((input "<length(strip(names))>")
    (output "2")
    (attributes ((names (MV (NULL (STRING Tom) NULL NULL (STRING Sriram) NULL)))))
    )
   ((input "<length(strip(names))>")
    (output "2")
    (attributes ((names (SV (LIST (NULL (STRING Tom) NULL NULL (STRING Sriram) NULL))))))
    )
   )
  )
 ))
("testTrim"
((classname hello)
 (runs
  (((input "<trim(name)>")
    (output "Ter")
    (attributes ((name (SV (STRING " Ter  \n")))
    		 ))
    )
   ((input "<strlen(name)>")
    (output "6")
    (attributes ((name (SV (STRING "012345")))
    		 ))
    )
   ((input "<reverse(names); separator=\", \">")
    (output "Sriram, Tom, Ter")
    (attributes ((names (MV ((STRING Ter) (STRING Tom) (STRING Sriram))))
    		 ))
    )
   ((input "<reverse(names); separator=\", \">")
    (output "Sriram, Tom, Ter")
    (attributes ((names (SV (LIST ((STRING Ter) (STRING Tom) (STRING Sriram)))))
    		 ))
    )
   )
  )
 ))
)
