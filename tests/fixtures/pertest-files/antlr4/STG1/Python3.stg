handleBeginArgument() ::= <<self.handleBeginArgument();>>
handleEndArgument() ::= <<self.handleEndArgument();>>
isLDelimNotComment() ::= <<self.isLDelimNotComment()>>
isRDelim() ::= <<self.isRDelim()>>
adjText() ::= <<self.adjText();>>
subTemplateHasIDs() ::= <<self.subTemplateHasIDs()>>
notsubTemplateHasIDs() ::= <<not self.subTemplateHasIDs()>>
enterSubTemplate() ::= <<self.enterSubTemplate()>>
exitSubTemplate() ::= <<self.exitSubTemplate()>>
