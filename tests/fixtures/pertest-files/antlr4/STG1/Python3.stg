prerrln(s) ::= <<print(<s>, file=sys.stderr)>>
prerr(s) ::= <<print(<s>,end='',file=sys.stderr)>>
location() ::= <<("line %s:%s:" % (self._tokenStartLine, self._tokenStartColumn))>>
dquotes(s) ::= <<"<s>">>
