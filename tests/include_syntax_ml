let find_token_index atn s =
  let open Interp.Raw in
  match Array.find_index (function (Some s') -> s = s' | None -> false) atn.token_symbolic_names with
      None -> Fmt.(failwithf "cannot find %s" s)
    | Some n -> n
;;

let check_tokens file l =
let open Interp.Raw in
let atn = fst (Exec.Atns.read_atn ~grammarType:LEXER ~file ()) in
l |> List.iter (fun s ->
         let i = find_token_index atn s in
         let sym = atn.token_symbolic_names.(i) in
         let lit = atn.token_literal_names.(i) in
         Fmt.(pf stdout "%s/%d: %a %a@." s i
                (option ~none:(const string "<none>") string) sym
                (option ~none:(const string "<none>") Dump.string) lit))

